<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Local manifest for Xiaomi 14T (degas, MT6897) on Android 17 (LineageOS 24.0 base).
         Copy to .repo/local_manifests/degas.xml and run repo sync. -->

    <remote name="saintysai" fetch="https://github.com/saintysai" />
    <remote name="lineage-upstream" fetch="https://github.com/LineageOS" />

    <!-- Device, prebuilt GKI kernel, and vendor blobs (OS3.0.306.0.WNEEUXM) -->
    <project path="device/xiaomi/degas"
             name="android_device_xiaomi_degas"
             remote="saintysai"
             revision="lineage-24.0" />

    <project path="device/xiaomi/degas-kernel"
             name="android_device_xiaomi_degas-kernel"
             remote="saintysai"
             revision="lineage-24.0"
             clone-depth="1" />

    <project path="vendor/xiaomi/degas"
             name="android_vendor_xiaomi_degas"
             remote="saintysai"
             revision="lineage-24.0"
             clone-depth="1" />

    <!-- Common MT6897 / Xiaomi HALs & vendor sepolicy -->
    <project path="hardware/mediatek"
             name="android_hardware_mediatek"
             remote="lineage-upstream"
             revision="lineage-24.0" />

    <project path="hardware/xiaomi"
             name="android_hardware_xiaomi"
             remote="lineage-upstream"
             revision="lineage-24.0" />

    <project path="device/mediatek/sepolicy_vndr"
             name="android_device_mediatek_sepolicy_vndr"
             remote="lineage-upstream"
             revision="lineage-24.0" />
</manifest>
