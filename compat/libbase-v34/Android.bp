package {
    default_applicable_licenses: ["degas_libbase_v34_license"],
}

license {
    name: "degas_libbase_v34_license",
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
    ],
    license_text: ["NOTICE.txt"],
}

cc_prebuilt_library_shared {
    name: "libbase-v34",
    vendor: true,
    compile_multilib: "64",
    srcs: ["arm64/libbase-v34.so"],
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "liblog",
    ],
}
