<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/xiaomi_settings_title">

    <PreferenceCategory
        android:key="display_category"
        android:title="@string/display_category_title">

        <ListPreference
            android:key="aod_brightness"
            android:title="@string/aod_brightness_title"
            android:entries="@array/aod_brightness_entries"
            android:entryValues="@array/aod_brightness_values"
            android:defaultValue="auto"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="true_tone"
            android:title="@string/true_tone_title"
            android:summary="@string/true_tone_summary"
            android:defaultValue="false"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="thermal_category"
        android:title="@string/thermal_category_title">

        <ListPreference
            android:key="thermal_profile"
            android:title="@string/thermal_profile_title"
            android:entries="@array/thermal_profile_entries"
            android:entryValues="@array/thermal_profile_values"
            android:defaultValue="6"
            android:persistent="false" />

        <Preference
            android:key="per_app_thermal"
            android:title="@string/per_app_thermal_title"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="smart_charging_thermal"
            android:title="@string/smart_charging_thermal_title"
            android:summary="@string/smart_charging_thermal_summary"
            android:defaultValue="false"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="touch_category"
        android:title="@string/touch_category_title">

        <SwitchPreferenceCompat
            android:key="high_touch_polling"
            android:title="@string/high_touch_polling_title"
            android:summary="@string/high_touch_polling_summary"
            android:defaultValue="false"
            android:persistent="false" />

        <Preference
            android:key="touch_tuning"
            android:title="@string/touch_tuning_title"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="audio_category"
        android:title="@string/audio_category_title">

        <Preference
            android:key="clear_speaker"
            android:title="@string/clear_speaker_title"
            android:summary="@string/clear_speaker_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="xiaomi_settings_footer"
        android:title="@string/xiaomi_settings_footer"
        android:selectable="false" />

</PreferenceScreen>
