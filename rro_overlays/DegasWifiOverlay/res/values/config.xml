    <!-- stock WifiResOverlay enables offloaded upgrade which still puts SAE
         into the profile; AOSP supplicant + gen4m cannot complete it -->
    <bool name="config_wifiSaeUpgradeOffloadEnabled">false</bool>

    <!-- Stock HyperOS OS3.0.306 Wi-Fi power & stability tuning (AospWifiResOverlay) -->
    <bool name="config_wifiEnableApfOnNonPrimarySta">true</bool>
    <bool name="config_wifiDisableUnwantedNetworkOnLowRssi">true</bool>
    <bool name="config_wifiSoftapAutoAppendLowerBandsToBandConfigurationEnabled">false</bool>
    <integer name="config_wifiPnoScanIntervalMultiplier">6</integer>
    <integer name="config_disconnectedP2pIfaceLowPriorityTimeoutMs">0</integer>
    <integer name="config_wifiDisableReasonAssociationRejectionThreshold">5</integer>
    <integer name="config_wifiDisableReasonAuthenticationFailureThreshold">5</integer>
    <string name="config_wifi_tcp_buffers" translatable="false">524288,1048576,16777216,262144,524288,16777216</string>
</resources>
