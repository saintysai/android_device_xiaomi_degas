allow priv_app vendor_hal_camera_bgservice:service_manager find;
allow priv_app mtk_hal_camera:binder { call transfer };
allow mtk_hal_camera priv_app:binder { call transfer };
allow priv_app mtk_hal_camera:fd use;
allow mtk_hal_camera priv_app:fd use;

r_dir_file(priv_app, sysfs_therm)
allow priv_app { proc_pressure_cpu proc_pressure_io proc_pressure_mem }:file r_file_perms;

allow priv_app apusys_device:chr_file { ioctl read write open };

allow priv_app hal_misys_vendor_service:service_manager find;
allow priv_app hal_misys_vendor_default:binder { call transfer };
allow hal_misys_vendor_default priv_app:binder { call transfer };
allow priv_app hal_misys_vendor_default:fd use;
allow hal_misys_vendor_default priv_app:fd use;
