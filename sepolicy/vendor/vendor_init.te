set_prop(vendor_init, vendor_batterysecret_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_fingerprint_prop)

rw_dir_file(vendor_init, sysfs_ged)
allow vendor_init sysfs_ged:file setattr;
allow vendor_init sysfs_gpu:dir search;
allow vendor_init sysfs_gpu:file setattr;

allow vendor_init sysfs_therm:dir search;
allow vendor_init sysfs_therm:file w_file_perms;
allow vendor_init sysfs_therm:file setattr;

allow vendor_init vendor_sysfs_displayfeature:dir search;
allow vendor_init vendor_sysfs_displayfeature:file setattr;
allow vendor_init sysfs_touch:dir search;
allow vendor_init sysfs_touch:file setattr;
allow vendor_init proc_touch:file setattr;

allow vendor_init persist_data_file:dir search;
allow vendor_init persist_data_file:file { open write };

allow vendor_init ufs_bsg_device:chr_file setattr;
