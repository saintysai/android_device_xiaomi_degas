type vendor_mi_thermald, domain, mlstrustedsubject;
type vendor_mi_thermald_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(vendor_mi_thermald)

r_dir_file(vendor_mi_thermald, sysfs)
allow vendor_mi_thermald sysfs:file { write lock append map open };
rw_dir_file(vendor_mi_thermald, sysfs_batteryinfo)
rw_dir_file(vendor_mi_thermald, sysfs_gpu)
rw_dir_file(vendor_mi_thermald, sysfs_leds)
rw_dir_file(vendor_mi_thermald, sysfs_power_supply)
rw_dir_file(vendor_mi_thermald, sysfs_therm)
rw_dir_file(vendor_mi_thermald, sysfs_thermal)
r_dir_file(vendor_mi_thermald, sysfs_thermal_sram)
rw_dir_file(vendor_mi_thermald, vendor_sysfs_displayfeature)

set_prop(vendor_mi_thermald, vendor_thermal_prop)

allow vendor_mi_thermald self:capability { chown fowner fsetid sys_boot };
allow vendor_mi_thermald self:capability2 { block_suspend wake_alarm };

allow vendor_mi_thermald sysfs_devices_system_cpu:file rw_file_perms;

allow vendor_mi_thermald thermal_core_data_file:dir create_dir_perms;
allow vendor_mi_thermald thermal_core_data_file:file create_file_perms;
allow vendor_mi_thermald vendor_data_file:dir create_dir_perms;
allow vendor_mi_thermald vendor_data_file:file create_file_perms;
